{
  "name": "MeTube Sender",
  "short_name": "MeTube Sender",
  "description": "A Chrome and Arc extension that sends YouTube videos, shorts and playlists to your self-hosted MeTube, and plays its downloads in an overlay on YouTube.",
  "lang": "en",
  "start_url": "./",
  "scope": "./",
  "display": "browser",
  "background_color": "#0f1115",
  "theme_color": "#0f1115",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
