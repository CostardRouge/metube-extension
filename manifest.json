{
  "manifest_version": 3,
  "name": "MeTube Sender",
  "short_name": "MeTube",
  "version": "1.0.0",
  "description": "Send YouTube videos to your self-hosted MeTube, and watch its downloads in an overlay player on YouTube.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Send to MeTube",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "scripting",
    "activeTab",
    "notifications",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.youtube.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "commands": {
    "toggle-overlay": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Play the current YouTube video from MeTube (overlay)"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "overlay/overlay.html"
      ],
      "matches": [
        "https://*.youtube.com/*"
      ]
    }
  ]
}
